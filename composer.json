{
    "name": "hakone/psr7-serializer",
    "description": "PSR-7 HTTP Message serializer",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.0",
        "php-http/discovery": "^1.18",
        "psr/http-client": "^1.0"
    },
    "autoload": {
        "files": ["src/functions.php"],
        "psr-4": {
            "Hakone\\Psr7Serializer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hakone\\Psr7Serializer\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
